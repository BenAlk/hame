# ─────────────────────────────────────────────────────────────
# Hame environment variables. Copy to `.env` and fill in.
# All vars are validated at API startup (apps/api/src/lib/env.ts).
# ─────────────────────────────────────────────────────────────

# --- Database ---
# Used by Prisma (api) and the postgres docker container.
POSTGRES_USER=hame
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=hame
DATABASE_URL=postgresql://hame:change-me-in-prod@localhost:5432/hame?schema=public

# --- API ---
NODE_ENV=development
API_PORT=4000
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173

# --- Auth ---
# Strong random secret for signing JWTs (e.g. `openssl rand -base64 48`).
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# 32-byte (64 hex chars) key for AES-256-GCM encryption of integration
# tokens at rest (Home Assistant token, Immich API key).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-characters-0000000000000000000000000000

# --- Frontend (Vite) ---
# Base URL the web app uses to reach the API.
VITE_API_URL=http://localhost:4000
