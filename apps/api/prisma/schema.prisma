// Hame database schema.
//
// Models are added per the build roadmap in hame-specification.md
// (each phase = its own migration, for a clean history):
//   Phase 0–1 — User & auth
//   Phase 2   — Tags, Items, Shopping lists, Storage locations, Pantry
//   Phase 3   — Pets, Chores, Chore instances
//   Phase 4   — Recipes, Meal plan entries, Household settings
//   Phase 5   — Bin collections, Custom events, Calendar sources + synced events

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  password     String // argon2 hashed
  firstName    String
  surname      String
  avatarUrl    String?
  colour       String // hex, e.g. "#3B82F6"
  dob          DateTime @db.Date // birthday — no time component
  role         Role     @default(MEMBER)
  // Bumped on a password or role change to invalidate outstanding session JWTs
  // (the token carries this value; requireAuth rejects a stale one). See §11.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations (added per phase as the referenced models land)
  itemsCreated         Item[]
  shoppingListsCreated ShoppingList[]
  shoppingItemsAdded   ShoppingListItem[]
  pantryEntriesAdded   PantryEntry[]
  choresCreated        Chore[]                 @relation("ChoreCreator")
  choresAssigned       Chore[]                 @relation("ChoreAssignee")
  choresRotation       Chore[]                 @relation("ChoreRotation")
  instancesAssigned    ChoreInstance[]         @relation("InstanceAssignee")
  instancesCompleted   ChoreInstance[]         @relation("InstanceCompleter")
  recipesCreated       Recipe[]
  mealPlanEntries      MealPlanEntry[]
  calendarObjects      CalendarObject[]
  calDavCredentials    CalDavCredential[]
  dashboardLayout      DashboardLayout?
  smartHomeSettings    SmartHomeSettings?
  notificationPrefs    NotificationPreference?
  notesAuthored        Note[]                  @relation("NoteAuthor")
  notesReceived        NoteRecipient[]         @relation("NoteRecipient")
  noteAcks             NoteAck[]
}

enum Role {
  ADMIN
  MEMBER
  // The shared wall-tablet account (spec §8.1): member-level permissions, but not
  // a household person — excluded from assignment/notification/stats rosters and
  // with no personal dashboard. Pages through members' dashboards read-only.
  TABLET
}

// ── Phase 2: Tags & Items (foundation layer) ─────────────────────────────────

model Tag {
  id      String   @id @default(uuid())
  name    String   @unique // "dairy", "frozen", "quick-add", "baking"
  kind    TagKind  @default(ITEM) // what the tag is *for* — see TagKind (spec §10 Phase 24)
  colour  String? // hex for chip display
  items   Item[]   @relation("ItemTags")
  chores  Chore[]  @relation("ChoreTags")
  recipes Recipe[] @relation("RecipeTags")
}

/// A tag's purpose (spec §10 Phase 24). One pool is shared by items, recipes and
/// chores, so without this every surface — and the language model — saw all of it.
/// The kind decides which surfaces offer a tag and whether the model may reach for
/// it: only ITEM is suggestible, DIETARY is a claim about contents that must be
/// applied by hand, and BEHAVIOURAL drives the app rather than describing anything.
enum TagKind {
  ITEM
  RECIPE
  DIETARY
  BEHAVIOURAL
}

model Item {
  id                  String             @id @default(uuid())
  name                String             @unique
  defaultQuantity     Float?
  defaultUnit         String? // "g", "ml", "pack"
  baseUnit            String? // canonical unit for stock maths — see spec §9.2
  typicalUnitGrams    Float? // grams of one countable unit (1 onion ≈ 110g) — see spec §10 Phase 4.5
  minimumQuantity     Float? // triggers low stock (expressed in baseUnit)
  isStaple            Boolean            @default(false) // pantry staple — excluded from generated shopping lists
  isConsumable        Boolean            @default(false) // household consumable — surfaced as a re-order checklist (spec §8.3)
  reorderIntervalDays Int? // rough re-order cadence (days) — captured now; drives the "probably due" highlight later (spec §12)
  shopId              String? // the one shop this is only buyable at (spec §8.3); null = buy anywhere
  shop                Shop?              @relation(fields: [shopId], references: [id], onDelete: SetNull)
  sectionId           String? // which part of the shop it's in (spec §8.3); null = groups under "Other"
  section             Section?           @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  storageType         StorageType? // how it's kept (spec §10 Phase 25); drives the pantry's default location
  createdById         String
  createdBy           User               @relation(fields: [createdById], references: [id])
  tags                Tag[]              @relation("ItemTags")
  shoppingItems       ShoppingListItem[]
  pantryEntries       PantryEntry[]
  recipeUses          RecipeIngredient[]
  barcodes            ItemBarcode[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

// ── Phase 2: Shopping ────────────────────────────────────────────────────────

model ShoppingList {
  id          String             @id @default(uuid())
  name        String // "Weekly Shop"
  status      ListStatus         @default(ACTIVE)
  createdById String
  createdBy   User               @relation(fields: [createdById], references: [id])
  items       ShoppingListItem[]
  archivedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model ShoppingListItem {
  id               String               @id @default(uuid())
  listId           String
  list             ShoppingList         @relation(fields: [listId], references: [id], onDelete: Cascade)
  itemId           String
  item             Item                 @relation(fields: [itemId], references: [id])
  quantity         Float?
  unit             String?
  notes            String?
  isBought         Boolean              @default(false)
  boughtAt         DateTime?
  sources          ShoppingItemSource[] @default([MANUAL]) // distinct channels merged into this line — drives the ×N badge (spec §8.3)
  addedById        String
  addedBy          User                 @relation(fields: [addedById], references: [id])
  rolledOverFromId String? // self-relation: the item this one was rolled over from
  rolledOverFrom   ShoppingListItem?    @relation("ItemRollover", fields: [rolledOverFromId], references: [id])
  rolledOverTo     ShoppingListItem[]   @relation("ItemRollover")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

enum ListStatus {
  ACTIVE
  ARCHIVED
}

// Where a shopping-list line's quantity came from (spec §8.3). A line unions
// every channel that fed it, so a summed quantity carries a ×N merge badge.
enum ShoppingItemSource {
  MANUAL
  MEAL_PLAN
  CONSUMABLES
  ROLLOVER
}

// ── Phase 2: Pantry ──────────────────────────────────────────────────────────

/// How an item is kept (spec §10 Phase 25). A closed, universal set — unlike
/// Section and Shop, which a household names itself — so it is an enum rather than
/// rows, and exactly one applies. That last part is the point: as four tags this
/// was a multi-select, and a model duly returned both "chilled" and "frozen" for
/// ice cream.
enum StorageType {
  FRESH
  CHILLED
  FROZEN
  AMBIENT
}

model StorageLocation {
  id          String        @id @default(uuid())
  name        String        @unique // "Main Fridge"
  icon        String?
  storageType StorageType? // what this place holds; null = no default destination
  pantryItems PantryEntry[]
  createdAt   DateTime      @default(now())
}

model PantryEntry {
  id                 String          @id @default(uuid())
  itemId             String
  item               Item            @relation(fields: [itemId], references: [id])
  locationId         String
  location           StorageLocation @relation(fields: [locationId], references: [id])
  quantity           Float
  unit               String?
  expiryDate         DateTime?       @db.Date
  addedById          String
  addedBy            User            @relation(fields: [addedById], references: [id])
  fromShoppingItemId String? // soft reference for traceability (no FK)
  addedAt            DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

// ── Phase 3: Pets ────────────────────────────────────────────────────────────

model Pet {
  id        String    @id @default(uuid())
  name      String
  species   Species
  breed     String?
  dob       DateTime? @db.Date
  imageUrl  String?
  chores    Chore[]
  createdAt DateTime  @default(now())
}

// ── Phase 3: Chores ──────────────────────────────────────────────────────────

model Chore {
  id             String          @id @default(uuid())
  title          String
  description    String?
  recurrenceType RecurrenceType
  intervalDays   Int? // for INTERVAL
  weekdays       Weekday[] // for WEEKLY
  dayOfMonth     Int? // for DATE_OF_MONTH (clamped to month length — spec §8.7)
  oneOffDate     DateTime?       @db.Date // for ONE_OFF
  assignmentMode AssignmentMode  @default(FIXED)
  assignedToId   String?
  assignedTo     User?           @relation("ChoreAssignee", fields: [assignedToId], references: [id])
  rotatingUsers  User[]          @relation("ChoreRotation")
  petId          String?
  pet            Pet?            @relation(fields: [petId], references: [id])
  tags           Tag[]           @relation("ChoreTags")
  isActive       Boolean         @default(true)
  createdById    String
  createdBy      User            @relation("ChoreCreator", fields: [createdById], references: [id])
  instances      ChoreInstance[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ChoreInstance {
  id            String    @id @default(uuid())
  choreId       String
  chore         Chore     @relation(fields: [choreId], references: [id], onDelete: Cascade)
  assignedToId  String
  assignedTo    User      @relation("InstanceAssignee", fields: [assignedToId], references: [id])
  dueDate       DateTime  @db.Date
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("InstanceCompleter", fields: [completedById], references: [id])
  notes         String?
  createdAt     DateTime  @default(now())
}

enum RecurrenceType {
  INTERVAL
  WEEKLY
  DATE_OF_MONTH
  ONE_OFF
}

enum AssignmentMode {
  FIXED
  ROTATING
}

enum Species {
  DOG
  CAT
  BIRD
  RABBIT
  OTHER
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// ── Phase 4: Recipes ─────────────────────────────────────────────────────────

model Recipe {
  id              String             @id @default(uuid())
  title           String
  description     String?
  imageUrl        String?
  sourceUrl       String? // set when URL-imported (spec §8.5)
  prepTimeMinutes Int?
  cookTimeMinutes Int?
  servings        Int                @default(4)
  mealTypes       MealType[] // slots this recipe can auto-fill when generating a plan (§8.6); empty = never auto-picked
  createdById     String
  createdBy       User               @relation(fields: [createdById], references: [id])
  ingredients     RecipeIngredient[]
  steps           RecipeStep[]
  tags            Tag[]              @relation("RecipeTags")
  mealEntries     MealPlanEntry[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model RecipeIngredient {
  id       String  @id @default(uuid())
  recipeId String
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  itemId   String
  item     Item    @relation(fields: [itemId], references: [id])
  quantity Float? // null for unquantified staples ("salt to taste")
  unit     String? // free-form display unit; normalised via Item.baseUnit for maths
  notes    String? // "finely chopped"
  optional Boolean @default(false)
  order    Int
}

model RecipeStep {
  id       String @id @default(uuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  order    Int
  text     String
}

// ── Phase 4: Meal planning ───────────────────────────────────────────────────

model MealPlanEntry {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  mealType    MealType
  recipeId    String? // null for non-recipe meals (customLabel)
  recipe      Recipe?  @relation(fields: [recipeId], references: [id])
  customLabel String? // "Takeaway", "Leftovers"
  servings    Int? // overrides recipe default when set
  notes       String?
  isGenerated Boolean  @default(false) // written by the meal-plan generator (§8.6); manual entries stay false and are never overwritten by a re-generate
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model HouseholdSettings {
  id                     String             @id @default("singleton") // enforce single row
  enabledMealTypes       MealType[]         @default([DINNER])
  ingredientNormaliser   NormaliserStrategy @default(BASIC) // spec §10 Phase 4.5
  caldavEnabled          Boolean            @default(false) // serve the calendar over CalDAV (spec §10 Phase 5.5)
  autoConsumableCadence  Boolean            @default(false) // Labs: estimate consumable re-order cadences from history (spec §10 Phase 8.5)
  householdAlertsEnabled Boolean            @default(true) // mobile top-bar critical-alert "poke" between members (spec §10 Phase 12)
  // Look an unseen barcode up against Open Food Facts (spec §10 Phase 14). On by
  // default — without it a first scan can only be named by hand — but every
  // unknown scan tells a third party a barcode, so it stays a household's call.
  barcodeLookupEnabled   Boolean            @default(true)
  updatedAt              DateTime           @updatedAt
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

// ── Phase 4.5: Ingredient normalisation ──────────────────────────────────────

enum NormaliserStrategy {
  BASIC
  DICTIONARY
  LLM
}

/// Ollama connection for the LLM ingredient normaliser (spec §10 Phase 4.5, §12).
/// Singleton mirroring the HomeAssistant/Immich config pattern. Ollama on the
/// homelab is unauthenticated, so there is no secret to encrypt at rest.
model OllamaConfig {
  id              String    @id @default("singleton") // enforce single row
  url             String?
  model           String    @default("llama3.1")
  isActive        Boolean   @default(false)
  lastConnectedAt DateTime?
  updatedAt       DateTime  @updatedAt
}

// ── Phase 6: Home Assistant ──────────────────────────────────────────────────

/// Home Assistant connection (spec §8.11, §10 Phase 6). Singleton mirroring the
/// Ollama/Immich config pattern. The long-lived access token is AES-256-GCM
/// encrypted at rest (spec §11) — `accessToken` holds the ciphertext blob, never
/// plaintext, and is never returned to the client.
model HomeAssistantConfig {
  id              String    @id @default("singleton") // enforce single row
  url             String?
  accessToken     String? // AES-256-GCM ciphertext (see lib/crypto.ts); never returned
  isActive        Boolean   @default(false)
  lastConnectedAt DateTime?
  updatedAt       DateTime  @updatedAt
}

/// Which Home Assistant entities an owner has curated onto the smart-home
/// dashboard widget (spec §8.12, §10 Phase 6.3, 7.1b). Per-owner, mirroring
/// DashboardLayout: one row per user plus a single fixed-id household/tablet row
/// (`isHousehold` true, `userId` null), so the widget shows a chosen few rather
/// than every controllable entity. `entityIds` is ordered — the widget renders
/// them in this order. Selection only; the live state is never persisted (§8.11).
///
/// `knownEntityIds` is the "already offered" set behind the new-device prompt:
/// every controllable entity Hame has shown this owner (added, dismissed, or
/// present at first setup). It's seeded once to whatever exists when the owner
/// first opens the prompt (`knownInitialised`), so existing/deliberately-skipped
/// devices never nag — only entities added later surface as suggestions.
model SmartHomeSettings {
  id               String   @id @default(uuid())
  userId           String?  @unique // null only for the single household/tablet row
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  isHousehold      Boolean  @default(false)
  entityIds        String[] @default([])
  knownEntityIds   String[] @default([])
  knownInitialised Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

// ── Phase 7.2: WiFi QR ───────────────────────────────────────────────────────

/// Household WiFi credentials for the dashboard's WiFi QR widget (spec §8.12,
/// §10 Phase 7.2). Singleton mirroring the HomeAssistant/Immich config pattern.
/// The password is AES-256-GCM encrypted at rest (spec §11) — `password` holds
/// the ciphertext blob (null for an open network), decrypted server-side only
/// for the member-level read that feeds the QR. The code is shown openly on the
/// wall tablet, so it isn't hidden from signed-in members, but it never sits in
/// the database as plaintext.
model WifiConfig {
  id        String       @id @default("singleton") // enforce single row
  ssid      String       @default("")
  password  String? // AES-256-GCM ciphertext (see lib/crypto.ts); null when open/unset
  security  WifiSecurity @default(WPA)
  hidden    Boolean      @default(false)
  isActive  Boolean      @default(false)
  updatedAt DateTime     @updatedAt
}

enum WifiSecurity {
  WPA
  WEP
  NONE
}

// ── Phase 5: Bins ────────────────────────────────────────────────────────────

/// A kerbside bin collection schedule (spec §8.9). Recurs but is never completed
/// and never one-off; INTERVAL (fortnightly / 4-weekly) anchors to `startDate`.
///
/// A bin's dates come from its `source` (spec §8.9, §10 Phase 5.6): a MANUAL bin
/// computes them from the recurrence schedule (not stored); an external source
/// (iCal / scraper / Home Assistant) has them fetched by a sync that caches
/// `BinOccurrence` rows and self-corrects each run. Only MANUAL is wired today.
model BinCollection {
  id                String          @id @default(uuid())
  name              String // "Burgundy bin"
  colour            String // hex for UI
  icon              String?
  sourceType        BinSourceType   @default(MANUAL)
  sourceConfig      Json? // provider connection details for external sources (null for MANUAL)
  lastSyncedAt      DateTime? // last successful external sync (null for MANUAL)
  recurrenceType    RecurrenceType? // MANUAL schedule; ONE_OFF unused for bins (enforced in Zod)
  intervalDays      Int?
  weekdays          Weekday[]
  dayOfMonth        Int?
  startDate         DateTime?       @db.Date // anchor for INTERVAL
  remindNightBefore Boolean         @default(true)
  remindMorningOf   Boolean         @default(true)
  isActive          Boolean         @default(true)
  occurrences       BinOccurrence[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

/// A concrete collection date cached from an external bin source (spec §10
/// Phase 5.6). MANUAL bins don't use this — their dates are computed live. Each
/// sync replaces a bin's rows wholesale, so the cache always reflects the source.
model BinOccurrence {
  id        String        @id @default(uuid())
  binId     String
  bin       BinCollection @relation(fields: [binId], references: [id], onDelete: Cascade)
  date      DateTime      @db.Date
  createdAt DateTime      @default(now())

  @@unique([binId, date])
}

/// Where a bin's collection dates come from (spec §8.9, §10 Phase 5.6).
enum BinSourceType {
  MANUAL
  ICAL
  SCRAPER
  HOME_ASSISTANT
}

// ── Phase 5: Custom events ───────────────────────────────────────────────────

/// A calendar event Hame owns (spec §8.10; §10 Phase 5.5) — date night, a visit,
/// etc. Stores the canonical iCalendar text plus extracted fields for Hame's own
/// grid and the aggregated feed. Absorbs the former CustomEvent and is served
/// read-write over CalDAV once the household enables it.
model CalendarObject {
  id               String          @id @default(uuid())
  uid              String          @unique // iCalendar UID; also the CalDAV resource name
  etag             String // opaque change tag for CalDAV concurrency (If-Match)
  icalRaw          String // canonical VCALENDAR text (kept verbatim on phone writes)
  title            String
  description      String?
  startTime        DateTime
  endTime          DateTime?
  allDay           Boolean         @default(false)
  colour           String?
  // Recurrence (INTERVAL/WEEKLY/DATE_OF_MONTH only — ONE_OFF is unused here,
  // since "doesn't repeat" is already `recurrenceType: null`). Mirrors the
  // chore/bin recurrence shape so the aggregated calendar can reuse the same
  // pure engine (`binOccurrencesInRange`) to expand a row into occurrences.
  recurrenceType   RecurrenceType?
  intervalDays     Int?
  weekdays         Weekday[]       @default([])
  dayOfMonth       Int?
  recurrenceAnchor DateTime?       @db.Date // immutable first-occurrence day; INTERVAL anchor
  createdById      String
  createdBy        User            @relation(fields: [createdById], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

// ── Phase 5: External calendar sync ──────────────────────────────────────────

/// An external calendar feed (spec §8.10). ICAL feeds are fetched + parsed on a
/// cron schedule into cached `SyncedEvent` rows; HOME_ASSISTANT lands in Phase 6.
model CalendarSource {
  id           String             @id @default(uuid())
  name         String // "Ben's Google"
  type         CalendarSourceType @default(ICAL)
  url          String // iCal URL (or HA entity, later)
  colour       String // hex for UI
  isActive     Boolean            @default(true)
  lastSyncedAt DateTime?
  events       SyncedEvent[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

/// A cached event from an external source. The sync replaces a source's rows
/// wholesale, so these are a derived cache — never edited in Hame.
model SyncedEvent {
  id          String         @id @default(uuid())
  sourceId    String
  source      CalendarSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId  String // dedupe key within a source (UID, plus occurrence for recurring)
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime?
  allDay      Boolean        @default(false)

  @@unique([sourceId, externalId])
}

enum CalendarSourceType {
  ICAL
  HOME_ASSISTANT
}

// ── Phase 5.5: CalDAV ────────────────────────────────────────────────────────

/// A CalDAV app password (spec §10 Phase 5.5). A device (e.g. DAVx5) authenticates
/// with HTTP Basic using the user's username + one of these — never the account
/// password. Only the argon2 hash is stored; the plaintext is shown once, at mint.
model CalDavCredential {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String // "Pixel 8", "Robin's phone"
  passwordHash String
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
}

// ── Phase 7: Dashboard ───────────────────────────────────────────────────────

/// A dashboard's saved widget layout (spec §8.12, §10 Phase 7.1). One row per
/// "dashboard owner": each User has their own, plus a single shared
/// household/tablet row (the wall tablet, spec §8.14) keyed by the fixed id
/// "household" with `userId` null and `isHousehold` true.
///
/// `layout` and `widgets` are free-form JSON validated by Zod in `@hame/shared`
/// (DashboardLayoutSchema): `layout` is the react-grid-layout positions per
/// breakpoint; `widgets` the ordered enabled widgets. Owners with no saved row
/// fall back to the shared default template, so a fresh clone needs no setup.
model DashboardLayout {
  id          String   @id @default(uuid())
  userId      String?  @unique // null only for the single household/tablet row
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  isHousehold Boolean  @default(false)
  layout      Json
  widgets     Json
  updatedAt   DateTime @updatedAt
}

// ── Phase 7.3: Idle mode / Immich screensaver ────────────────────────────────

/// Connection to a self-hosted Immich photo library (spec §8.14, §10 Phase 7.3).
/// Singleton mirroring the HomeAssistant/WiFi config pattern. The API key is
/// AES-256-GCM encrypted at rest (spec §11) — `apiKey` holds the ciphertext blob,
/// decrypted server-side only, and is *never* returned to the client (the read
/// shape carries only `hasApiKey`). The browser never gets Immich credentials:
/// the idle screensaver pulls photos through Hame's backend proxy, so it works
/// remotely without exposing Immich. `selectedAlbumIds` empty = all photos.
model ImmichConfig {
  id               String    @id @default("singleton") // enforce single row
  url              String?
  apiKey           String? // AES-256-GCM ciphertext (see lib/crypto.ts); never returned
  selectedAlbumIds String[]  @default([])
  isActive         Boolean   @default(false)
  lastConnectedAt  DateTime?
  updatedAt        DateTime  @updatedAt
}

/// Wall-tablet idle / screensaver behaviour (spec §8.14, §10 Phase 7.3).
/// Singleton — household-wide, not per-user, because the wall tablet is shared
/// and no one is actively logged in during idle. After `activationMinutes` of
/// inactivity the dashboard cycles Immich photos (`photoDisplaySeconds` each)
/// and a large clock (`clockDisplaySeconds`); touch wakes it. `immichEnabled`
/// off (or no photos) falls back to clock-only.
model IdleModeSettings {
  id                     String   @id @default("singleton") // enforce single row
  enabled                Boolean  @default(true)
  activationMinutes      Int      @default(5)
  photoDisplaySeconds    Int      @default(30)
  clockDisplaySeconds    Int      @default(120)
  shufflePhotos          Boolean  @default(true)
  showWeatherInClockMode Boolean  @default(true)
  immichEnabled          Boolean  @default(true)
  showBinsInIdle         Boolean  @default(true) // rotate in a "bin due today/tomorrow" screen
  binDueCutoffMinutes    Int? // minutes since local midnight; past this, "due today" stops counting (null = shown all day)
  showMealsInIdle        Boolean  @default(true) // rotate in today's meal for the current slot
  showNotesInIdle        Boolean  @default(true) // rotate in the household QuickNotes board
  updatedAt              DateTime @updatedAt
}

/// Scheduled overnight black-screen mode for the wall tablet (spec §8.14a, §10
/// Phase 26) — replaces relying on a separate kiosk app to blank the screen.
/// Singleton, household-wide, mirroring IdleModeSettings. Times are
/// minutes-since-midnight in the tablet's local time (not server UTC, unlike
/// the backup schedule — this drives a visible screen state a person sets
/// their own clock by). `startMinutes > endMinutes` is a normal overnight
/// window (e.g. 23:00-07:00) and wraps past midnight.
model SleepModeSettings {
  id           String   @id @default("singleton") // enforce single row
  enabled      Boolean  @default(false)
  startMinutes Int      @default(1320) // 22:00
  endMinutes   Int      @default(420) // 07:00
  updatedAt    DateTime @updatedAt
}

// ── Phase 8: Notifications ───────────────────────────────────────────────────

/// Per-user notification preferences (spec §8.13, §10 Phase 8). One row per user
/// (created lazily, all categories on by default). Scheduled reminders are pushed
/// through Home Assistant's mobile-app notify service (HA handles the phone push),
/// so Hame keeps no notification infra of its own — there is deliberately no
/// stored Notification feed (spec §7 defines none): a reminder fires once at its
/// moment and is gone. `haNotifyService` is the `notify.*` target the user picked
/// for their phone (e.g. `mobile_app_bens_phone`); without one, push is skipped.
/// `criticalAlerts` opts into the high-priority / iOS critical payload that breaks
/// through silent/DND (off by default — routine reminders shouldn't override it).
model NotificationPreference {
  id                   String  @id @default(uuid())
  userId               String  @unique
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  binReminders         Boolean @default(true)
  choreReminders       Boolean @default(true)
  expiryWarnings       Boolean @default(true)
  lowStockAlerts       Boolean @default(true)
  petCareReminders     Boolean @default(true)
  customEventReminders Boolean @default(true)
  // Master switch for Home Assistant phone push; in-app toasts are unaffected.
  pushViaHA            Boolean @default(true)
  // The HA `notify.*` service for this user's phone (the part after `notify.`),
  // e.g. `mobile_app_bens_phone`. Null until they pick one — push then no-ops.
  haNotifyService      String?
  // Opt-in: send as a high-priority / iOS critical alert (bypasses silent/DND).
  criticalAlerts       Boolean @default(false)
  // A direct QuickNote (§8.16) to this user pings them via the push above.
  directNoteAlerts     Boolean @default(true)
  // Opt-in (§10 Phase 21): a household alert may briefly lift this phone's Do Not
  // Disturb, ringer mode and volume, then put them straight back. Off by default —
  // it writes settings on someone's device. Household alerts only, never the digest.
  alertBreakThrough    Boolean @default(false)

  updatedAt DateTime @updatedAt
}

// ── Phase 10: Integrations framework ─────────────────────────────────────────

/// A configured instance of an integration provider (spec §9.9, §10 Phase 10) —
/// the pluggable-provider seam (bin/calendar sources) generalised. A first-party
/// provider module, registry-keyed by `providerId`, pulls data from an external
/// self-hosted service and returns it normalised. `secret` holds the AES-256-GCM
/// ciphertext of the provider's credential (see lib/crypto.ts), null when a
/// provider needs none, and is never returned to the client. A STATUS provider's
/// latest reading caches on `snapshot`; a CALENDAR provider's dated events cache
/// as `IntegrationEvent` rows (the SyncedEvent/BinOccurrence mould) and merge into
/// the aggregated calendar. A poller (INTEGRATION_SYNC_CRON) refreshes each active
/// integration and self-corrects like the other external sources.
model Integration {
  id                  String             @id @default(uuid())
  providerId          String // registry key: "gitea", "truenas"
  kind                IntegrationKind // matches the provider's declared kind
  name                String // user label: "Homelab NAS", "Gitea"
  config              Json // non-secret provider config (url, owner/repo, …)
  secret              String? // AES-256-GCM ciphertext (see lib/crypto.ts); never returned
  isActive            Boolean            @default(true)
  pollIntervalSeconds Int                @default(900)
  snapshot            Json? // last successful STATUS reading (normalised metrics)
  lastSyncedAt        DateTime?
  lastError           String?
  events              IntegrationEvent[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

/// A dated event cached from a CALENDAR-kind integration — the SyncedEvent /
/// BinOccurrence mould (spec §7.7). Each poll replaces a source's rows wholesale,
/// so this is a derived cache, never edited in Hame; the aggregated calendar
/// (§9.5) merges these alongside every other source.
model IntegrationEvent {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  externalId    String // dedupe key within the source
  title         String
  startTime     DateTime
  endTime       DateTime?
  allDay        Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@unique([integrationId, externalId])
}

enum IntegrationKind {
  STATUS
  CALENDAR
}

// ── Phase 8.9: Automated on-disk backups ─────────────────────────────────────

/// Automated backup schedule (spec §8.15, §10 Phase 8.9). Singleton extending the
/// manual export/import (§8.8): a scheduled job seals the same passphrase-encrypted
/// envelope and writes it to the host-mounted `BACKUP_DIR` with rolling retention,
/// so backups survive a dead container or database. `passphrase` holds the
/// AES-256-GCM ciphertext (see lib/crypto.ts) of the seal passphrase — never
/// returned to the client — because a scheduled run has no human to type one; the
/// files still decrypt with the passphrase *alone* (not this instance's
/// `ENCRYPTION_KEY`), which is what lets them restore onto fresh hardware. The
/// schedule lives here (not in a cron env) so an hourly tick reads it and a pure
/// `isBackupDue` decides — catching up a run missed while the container was down.
model BackupSettings {
  id             String           @id @default("singleton") // enforce single row
  enabled        Boolean          @default(false)
  frequency      BackupFrequency  @default(DAILY)
  hour           Int              @default(3) // hour-of-day (UTC / container time)
  weekday        Int              @default(0) // 0=Sun … 6=Sat, for WEEKLY
  retentionCount Int              @default(7) // rolling max; oldest pruned past this
  passphrase     String? // AES-256-GCM ciphertext (see lib/crypto.ts); never returned
  lastRunAt      DateTime?
  lastStatus     BackupRunStatus?
  lastError      String?
  updatedAt      DateTime         @updatedAt
}

enum BackupFrequency {
  DAILY
  WEEKLY
}

enum BackupRunStatus {
  SUCCESS
  FAILURE
}

// ── Phase 11: QuickNotes (household noteboard) ───────────────────────────────

/// A QuickNote (§8.16) — the household "fridge board". Short, glanceable, shown
/// on dashboards and the wall-tablet screensaver, either household-wide or as a
/// private direct note to specific members. Ephemeral: an optional expiry ages it
/// out (pinned notes never expire) and a nightly sweep hard-deletes past-expiry rows.
model Note {
  id         String          @id @default(uuid())
  authorId   String
  author     User            @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body       String // the note text (short; ≤280 chars, enforced by Zod)
  audience   NoteAudience    @default(HOUSEHOLD)
  recipients NoteRecipient[] // set only for DIRECT — the members it's addressed to
  colour     String? // sticky tint (hex); null = inherit the author's User.colour
  pinned     Boolean         @default(false) // sorts to top; exempt from expiry
  expiresAt  DateTime? // null = never (pinned, or an explicit "keep")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  acks       NoteAck[]

  @@index([audience])
}

/// One addressee of a DIRECT note (§8.16). A note can be sent to several members
/// ("Sam and Ada", or "everyone but Ben"); each such member is one row here. A
/// HOUSEHOLD note has no recipient rows.
model NoteRecipient {
  id     String @id @default(uuid())
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation("NoteRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@index([userId])
}

/// Per-user read/dismiss state for a note. A row means "this user has seen it";
/// `dismissed` hides a household note from that user's own board without removing
/// it for anyone else. Also powers the sender's "seen" indicator on a direct note.
model NoteAck {
  id        String   @id @default(uuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dismissed Boolean  @default(false)
  seenAt    DateTime @default(now())

  @@unique([noteId, userId])
}

enum NoteAudience {
  HOUSEHOLD // everyone's board + the wall-tablet screensaver
  DIRECT // one member only; never shown on the shared tablet
}

// ── Phase 13: Shops ──────────────────────────────────────────────────────────

/// A shop an item can only be bought at (spec §8.3). User-defined rows rather
/// than an enum, so a household names its own shops without a migration —
/// the StorageLocation mould. An Item carries at most one: exclusive to this
/// shop, or (null) buyable anywhere. Deleting a shop is `SetNull`, returning
/// its items to generic rather than cascading into deleting products.
model Shop {
  id        String   @id @default(uuid())
  name      String   @unique // "Lidl", "Aldi", "Tesco"
  colour    String? // hex for chip display
  items     Item[]
  createdAt DateTime @default(now())
}

// ── Phase 14: Barcode scanning ───────────────────────────────────────────────

/// A scanned barcode linked to an Item (spec §8.4). Many-to-one by design: Item
/// is a generic concept ("Milk") while a barcode identifies one specific
/// product, so three supermarkets' milk are three codes against one Item —
/// which is why this is its own model rather than a column on Item.
///
/// Once a code is here it resolves locally, so only a never-seen barcode ever
/// leaves the network. The library therefore fills as a side effect of ordinary
/// unpacking, which is what makes in-shop ticking viable later (spec §12).
model ItemBarcode {
  id      String   @id @default(uuid())
  code    String   @unique // EAN-13 / UPC as scanned
  itemId  String
  item    Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  label   String? // product name as looked up, so a multi-barcode Item stays legible
  addedAt DateTime @default(now())

  @@index([itemId])
}

// ── Phase 18: Sections (which part of the shop an item is in) ────────────────

/// The part of the shop an item is found in (spec §8.3) — the thing that
/// sections a shopping list while you walk round it.
///
/// A **field, not a tag**, for the same two reasons `Shop` is: an item is in
/// exactly one section, and a tag cannot stop it claiming both `dairy` and
/// `frozen`; and a field earns a real picker plus `position`, which is what lets
/// the list read in the order you actually walk rather than alphabetically.
/// Retiring the old aisle tags also un-mixes the shared tag pool, so a tag
/// suggestion for a recipe stops being offered supermarket vocabulary.
///
/// Deleting a section is `SetNull` — its items fall back to the "Other" group,
/// never cascade into deleting products.
model Section {
  id        String   @id @default(uuid())
  name      String   @unique // "Produce", "Dairy", "Frozen"
  colour    String? // hex for chip display
  position  Int // walking order through the shop; ties break on name
  items     Item[]
  createdAt DateTime @default(now())

  @@index([position])
}
