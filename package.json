{
  "name": "hame",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted household management app for couples and families.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --filter @hame/shared build && concurrently -n shared,api,web -c blue,green,magenta \"pnpm --filter @hame/shared dev\" \"pnpm --filter @hame/api dev\" \"pnpm --filter @hame/web dev\"",
    "build": "pnpm --filter @hame/shared build && pnpm --filter @hame/api build && pnpm --filter @hame/web build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @hame/api db:migrate",
    "db:seed": "pnpm --filter @hame/api db:seed",
    "db:studio": "pnpm --filter @hame/api db:studio",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
